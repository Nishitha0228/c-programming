# include<stdio.h>
void main()
{
    int i,j,k;
    int block=3;
    int line=4;
    int star=5;
    int x=0,a;
    for(int i=0;i<block;i++)
        {
            a=0;
            for (int j=0;j<line-i;j++)
                {
                    for(int k=0;k<star;k++)
                        {
                            printf("* ");
                            x++;
                            a++;   
                        }
                    printf("\n");
                }
                    printf("___________\n");
                    printf("total in %d\n",a);
        }
    printf("total in the block is %d",x);
}
