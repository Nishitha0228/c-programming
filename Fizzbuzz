#include <stdio.h>
void main()
{
    int n=25;
    for(int i=1;i<=n;i++)
        {
            if(i%3==0 && i%5==0)
                printf("\"Fizzbuzz\"");
            else if(i%5==0)
                printf("\"Buzz\"");
            else if(i%3==0)
                printf("\"Fizz\"");
            else
                printf(" %d ",i);
                
        }
}
