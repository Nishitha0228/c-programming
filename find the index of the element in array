#include <stdio.h>
#include <stdbool.h>
int main()
{
    int arr[]={1,2,3,4,5,6,9};
    int len=sizeof (arr)/sizeof(arr[0]);
    int k,i;
    bool f=false;
    printf("enter k value:");
    scanf("%d",&k);
    for(i=0;i<len;i++)
    {
        if(k==arr[i])
        {
            f=true;
            printf("k value present in index: %d",i);
            
        }   
    }
    if(!f){
        printf("element not found");
    }
}
